{
  "name": "counter-intelligence-angular",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/release.mts whats-new public/whats-new.json && ng build --define \"APP_VERSION='${APP_VERSION:-$(git describe --tags --match 'v[0-9]*' 2>/dev/null)}'\" --define \"BUILD_ID='$(git rev-parse --short=7 HEAD)'\" --define \"BUILD_DATE='$(date +%F)'\" --define \"TURNSTILE_SITE_KEY='${TURNSTILE_SITE_KEY:-}'\" --define \"MAPS_NAME='${MAPS_NAME:-}'\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\" \"worker/**/*.ts\" \"cypress/**/*.ts\" cypress.config.ts cypress.visual.config.ts cypress.readme.config.ts openapi-ts.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\" \"worker/**/*.ts\" \"cypress/**/*.ts\" cypress.config.ts cypress.visual.config.ts cypress.readme.config.ts openapi-ts.config.ts",
    "validate-data": "node scripts/validate-data.mts",
    "release": "node scripts/release.mts",
    "test:scripts": "vitest run scripts",
    "test:worker": "vitest run worker",
    "typecheck:worker": "tsc -p tsconfig.worker.json && tsc -p tsconfig.worker-spec.json",
    "api:types": "openapi-ts",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:check": "npm run api:lint && npm run api:types && git diff --exit-code -- api/generated",
    "e2e": "ng run counter-intelligence-angular:cypress-run",
    "e2e:open": "ng e2e",
    "visual:base": "VISUAL_BASE=1 ng run counter-intelligence-angular:cypress-run --config-file cypress.visual.config.ts --browser chromium",
    "visual": "npm run visual:shoot && npm run visual:compare",
    "visual:shoot": "ng run counter-intelligence-angular:cypress-run --config-file cypress.visual.config.ts --browser chromium",
    "visual:compare": "reg-cli cypress/snapshots/actual cypress/snapshots/expected cypress/snapshots/diff -R cypress/snapshots/report.html -J cypress/snapshots/reg.json -M 0.1",
    "readme:screenshots": "ng run counter-intelligence-angular:cypress-run --config-file cypress.readme.config.ts --browser chromium",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "^2.58.1",
    "@types/node": "^26.6.4",
    "angular-eslint": "22.5.0",
    "cypress": "16.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "reg-cli": "0.18.16",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}

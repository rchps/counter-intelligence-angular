{
  "name": "counter-intelligence-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --define \"BUILD_ID='$(git rev-parse --short=7 HEAD)'\" --define \"BUILD_DATE='$(date +%F)'\" --define \"REPORT_EMAIL='${REPORT_EMAIL:-}'\" --define \"MAPS_NAME='${MAPS_NAME:-}'\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\" \"cypress/**/*.ts\" cypress.config.ts cypress.visual.config.ts cypress.readme.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mts\" \"cypress/**/*.ts\" cypress.config.ts cypress.visual.config.ts cypress.readme.config.ts",
    "validate-data": "node scripts/validate-data.mts",
    "test:scripts": "vitest run scripts",
    "e2e": "ng run counter-intelligence-angular:cypress-run",
    "e2e:open": "ng e2e",
    "visual:base": "VISUAL_BASE=1 ng run counter-intelligence-angular:cypress-run --config-file cypress.visual.config.ts --browser chromium",
    "visual": "ng run counter-intelligence-angular:cypress-run --config-file cypress.visual.config.ts --browser chromium",
    "readme:screenshots": "ng run counter-intelligence-angular:cypress-run --config-file cypress.readme.config.ts --browser chromium",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "angular-eslint": "22.5.0",
    "cypress": "16.1.0",
    "cypress-visual-regression": "^6.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.0"
  }
}

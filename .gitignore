/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Claude Code agent worktrees (each is a full checkout of the repo)
/.claude/worktrees/

# System files
.DS_Store
Thumbs.db

# Cypress run output
/cypress/screenshots
/cypress/videos
/cypress/downloads
/cypress/snapshots

